# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files — never commit real Firebase keys
.env
.env.local
.env.*.local

# Agent loop state (local-only workspace)
.agent/

# Firebase CLI local cache
.firebase/
firebase-debug.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Design canvas: the sources are kept, the seeded page is a 2 MB generated
# bundle that is republished from them.
.design/*.html
!.design/*.dc.html

# Seeded design canvases are ~2MB build output; the artboards beside them are the source.
.design/**/*-layouts.html
.design/**/*-options.html
.design/**/__pycache__/
